{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "stacksTransactions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "enabled",
        "credentialsSecret",
        "image"
      ],
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "credentialsSecret": {
          "type": "string",
          "minLength": 1,
          "maxLength": 63,
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "repository",
            "tag"
          ],
          "properties": {
            "repository": {
              "type": "string",
              "minLength": 1
            },
            "tag": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "bitcoinProduction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "credentialsSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "credentialsSecret": {"type": "string", "minLength": 1, "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 5},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 253, "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]*[a-z0-9])?)*$"}, "uniqueItems": true}
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentReconciles", "leaderElection", "logLevel"],
      "properties": {
        "maxConcurrentReconciles": {"type": "integer", "minimum": 1, "maximum": 32},
        "leaderElection": {"type": "boolean"},
        "logLevel": {"enum": ["debug", "info", "error", "panic"]}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name", "annotations"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)$"},
        "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["service"],
      "properties": {
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled", "port", "annotations"],
          "properties": {
            "enabled": {"type": "boolean"},
            "port": {"type": "integer", "minimum": 1, "maximum": 65535},
            "annotations": {"type": "object", "additionalProperties": {"type": "string"}}
          }
        }
      }
    },
    "podAnnotations": {"type": "object", "additionalProperties": {"type": "string"}},
    "podLabels": {"type": "object", "additionalProperties": {"type": "string"}},
    "nodeSelector": {"type": "object", "additionalProperties": {"type": "string"}},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"},
    "resources": {"type": "object"}
  },
  "required": ["replicaCount", "image", "controller", "serviceAccount", "metrics", "podAnnotations", "podLabels", "nodeSelector", "tolerations", "affinity", "resources"]
}
