{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 5},
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxConcurrentReconciles", "leaderElection", "logLevel"],
      "properties": {
        "maxConcurrentReconciles": {"type": "integer", "minimum": 1, "maximum": 32},
        "leaderElection": {"type": "boolean"},
        "logLevel": {"enum": ["debug", "info", "error", "panic"]}
      }
    },
    "serviceAccount": {
      "type": "object",
      "additionalProperties": false,
      "required": ["create", "name"],
      "properties": {
        "create": {"type": "boolean"},
        "name": {"type": "string", "maxLength": 253, "pattern": "^(?:|[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?(?:\\.[a-z0-9](?:[-a-z0-9]{0,61}[a-z0-9])?)*)$"}
      }
    },
    "resources": {"type": "object"}
  },
  "required": ["replicaCount", "image", "controller", "serviceAccount", "resources"]
}
