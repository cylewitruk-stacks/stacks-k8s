{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["networkDelay", "networkPartition", "chaosMesh", "agent"],
  "properties": {
    "networkDelay": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "networkPartition": {"type": "object", "additionalProperties": false, "required": ["enabled"], "properties": {"enabled": {"type": "boolean"}}},
    "chaosMesh": {"type": "object", "additionalProperties": false, "required": ["externalVersion"], "properties": {"externalVersion": {"type": "string", "enum": ["", "2.8.4"]}}},
    "agent": {"type": "object", "additionalProperties": false, "required": ["serviceAccountName"], "properties": {"serviceAccountName": {"type": "string", "maxLength": 63, "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"}}}
  }
}
