{
  "apiGroup": "actions.stacks.org",
  "apiVersion": "v1alpha1",
  "attributionValues": [
    "RPCResponse",
    "Uncertain"
  ],
  "attemptOutcomeValues": [
    "IntentRecorded",
    "Acknowledged",
    "ProvenAbsent",
    "Ambiguous"
  ],
  "ambiguousMutationOutcome": "Inconclusive",
  "boundaryPolicyFields": [
    "allowEpochBoundaryCrossing",
    "allowRewardCycleBoundaryCrossing",
    "allowPreparePhaseBoundaryCrossing"
  ],
  "boundaryAssessmentRange": "inclusive:[originalHeight-depth+1,originalHeight-depth+replacementBlocks]",
  "chainIdentityFields": [
    "height",
    "bestBlockHash",
    "chainwork"
  ],
  "completedAttributionSource": "rpc-response-block-hashes-only",
  "contract": "actions.stacks.org/bitcoin-actions/v1alpha1",
  "credential": {
    "authenticationMode": "rpcauth",
    "expectedDigestAlgorithm": "sha256",
    "expectedDigestFormat": "sha256:<64-lowercase-hex>",
    "key": "bitcoin-rpc.conf",
    "passwordRandomBytes": 32,
    "rpcauthSaltRandomBytes": 16,
    "secretName": "stacks-bitcoin-rpc",
    "serverConfigFields": [
      "rpcauth"
    ],
    "secretRequiredImmutable": true,
    "valueEncoding": "base64url-without-padding",
    "usernameRandomBytes": 24
  },
  "destinationUniqueness": "advisory",
  "getBlockVerbosity": 2,
  "generationCadence": {
    "delayAppliesBefore": "every-block-including-first",
    "fixedFields": [
      "interval"
    ],
    "immediateBatchWithinBlocksCEL": "!has(self.cadence.immediate) || self.cadence.immediate.batchSize <= self.blocks",
    "immediateFields": [
      "batchSize"
    ],
    "intervalCEL": "duration(self) >= duration('100ms') && duration(self) <= duration('5m')",
    "modes": [
      "immediate",
      "fixed",
      "uniform",
      "sequence"
    ],
    "oneOfCEL": "[has(self.immediate), has(self.fixed), has(self.uniform), has(self.sequence)].filter(x, x).size() == 1",
    "scheduledBatchSize": 1,
    "sequenceFields": [
      "delays"
    ],
    "sequenceLengthCEL": "!has(self.cadence.sequence) || self.cadence.sequence.delays.size() == self.blocks",
    "sequenceItemsMaximum": 288,
    "statusFields": [
      "mode",
      "selectedInterval",
      "scheduledForBlock",
      "dueAt"
    ],
    "uniformFields": [
      "minimumInterval",
      "maximumInterval"
    ],
    "uniformOrderCEL": "duration(self.minimumInterval) <= duration(self.maximumInterval)",
    "uniformReplayClaim": false,
    "uniformSelection": "crypto-rand-unbiased-inclusive-integer-nanoseconds"
  },
  "kinds": [
    {
      "kind": "BitcoinBlockGeneration",
      "rpcMethods": [
        "getblockchaininfo",
        "validateaddress",
        "generatetoaddress",
        "getblockhash",
        "getblockheader",
        "getblock",
        "getchaintips"
      ],
      "specFields": [
        "networkRef",
        "bitcoinNodeRef",
        "blocks",
        "cadence",
        "destinationAddress",
        "timeout"
      ],
      "statusFields": [
        "requestedBlocks",
        "generatedBlocks",
        "generatedBlockHashes",
        "cadence",
        "startingChain",
        "observedChain",
        "reservation",
        "rpcAttempts",
        "attribution"
      ]
    },
    {
      "kind": "BitcoinReorganization",
      "rpcMethods": [
        "getblockchaininfo",
        "validateaddress",
        "getblockhash",
        "getblockheader",
        "getblock",
        "getchaintips",
        "invalidateblock",
        "generatetoaddress",
        "reconsiderblock"
      ],
      "specFields": [
        "networkRef",
        "bitcoinNodeRef",
        "depth",
        "replacementBlocks",
        "replacementInterval",
        "destinationAddress",
        "boundaryPolicy",
        "timeout"
      ],
      "statusFields": [
        "originalChain",
        "forkParent",
        "originalBlockHashes",
        "replacementBlockHashes",
        "finalChain",
        "boundaryAssessment",
        "reservation",
        "rpcAttempts",
        "attribution"
      ]
    }
  ],
  "limits": {
    "batchSizeMaximum": 16,
    "blockGenerationMaximum": 288,
    "destinationAddressMaximumLength": 90,
    "destinationAddressMinimumLength": 14,
    "intervalMaximum": "5m",
    "intervalMinimum": "100ms",
    "reorganizationDepthMaximum": 144,
    "replacementBlocksMaximum": 288,
    "rpcAttemptsMaximum": 320,
    "timeoutMaximum": "24h"
  },
  "reservationContract": "bitcoin.stacks.org/reservation/v1alpha1",
  "rpcAttemptScope": "mutation-methods-only",
  "rpcAttemptFields": [
    "sequence",
    "method",
    "expectedHeight",
    "expectedTip",
    "requestedBlocks",
    "destinationAddress",
    "acquisitionToken",
    "startedAt",
    "deadline",
    "outcome",
    "blockHashes"
  ],
  "provenAbsentScope": "all-known-tips",
  "protocolSchedule": {
    "unknownRequiresAllBoundaryOptIns": true,
    "v1Source": "none"
  },
  "specImmutabilityRule": "self == oldSelf",
  "topologyDependency": {
    "affectedContracts": [
      "leaf-spec-v1.json",
      "inventory-v1.json"
    ],
    "aggregateField": "spec.bitcoinRPCAuth",
    "compiledLeafField": "spec.bitcoinRPCAuth",
    "fieldType": "ConfigObjectRef",
    "generatedProfiles": [
      "bitcoin-regtest/v2",
      "nakamoto-regtest-node/v2"
    ],
    "key": "bitcoin-rpc.conf",
    "name": "stacks-bitcoin-rpc",
    "requiredExpectedDigest": true
  }
}
