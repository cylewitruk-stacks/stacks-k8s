{
  "apiGroup": "bitcoin.stacks.org",
  "apiVersion": "v1alpha1",
  "ambiguityBehavior": "hold-until-rpc-not-after-release-no-retry-no-completion-claim",
  "cadence": {
    "delayAppliesBefore": "every-block-including-first",
    "fixedFields": [
      "interval"
    ],
    "intervalCEL": "duration(self) >= duration('1s') && duration(self) <= duration('1h')",
    "modes": [
      "fixed",
      "uniform"
    ],
    "oneOfCEL": "[has(self.fixed), has(self.uniform)].filter(x, x).size() == 1",
    "uniformFields": [
      "minimumInterval",
      "maximumInterval"
    ],
    "uniformOrderCEL": "duration(self.minimumInterval) <= duration(self.maximumInterval)",
    "uniformReplayClaim": false,
    "uniformSelection": "crypto-rand-unbiased-inclusive-integer-nanoseconds"
  },
  "conditionTypes": [
    "TargetResolved",
    "CredentialsReady",
    "CadenceAccepted",
    "Ready"
  ],
  "completionClaim": false,
  "conditionsRequireObservedGeneration": true,
  "contract": "bitcoin.stacks.org/block-production/v1alpha1",
  "finalizer": "bitcoin.stacks.org/block-production",
  "historyContract": "bounded-status-structured-logs-passive-observation",
  "immutableSpecFields": [
    "networkRef",
    "bitcoinNodeRef",
    "destinationAddress"
  ],
  "immutableSpecFieldsCEL": "self.networkRef == oldSelf.networkRef && self.bitcoinNodeRef == oldSelf.bitcoinNodeRef && self.destinationAddress == oldSelf.destinationAddress",
  "kind": "BitcoinBlockProduction",
  "limits": {
    "intervalMaximum": "1h",
    "intervalMinimum": "1s",
    "maximumAcknowledgedBlocksBetweenStatusWrites": 16,
    "maximumStatusWriteInterval": "30s",
    "recentBlockHashesMaximum": 8
  },
  "mutableSpecFields": [
    "cadence",
    "paused"
  ],
  "mutationBatchSize": 1,
  "nameMatchesTargetCEL": "self.metadata.name == self.spec.bitcoinNodeRef.name",
  "pausedDefault": false,
  "perBlockIntentJournal": false,
  "phaseSemantics": {
    "degraded": "previously-bound-target-not-currently-mutable",
    "identityReplacementReasons": [
      "NetworkIdentityChanged",
      "TargetIdentityChanged"
    ],
    "pending": "before-first-successful-identity-bind"
  },
  "phases": [
    "Pending",
    "Running",
    "Paused",
    "Degraded",
    "Terminating"
  ],
  "reservationContract": "bitcoin.stacks.org/reservation/v1alpha1",
  "rpcMethods": [
    "getblockchaininfo",
    "validateaddress",
    "generatetoaddress"
  ],
  "specFields": [
    "networkRef",
    "bitcoinNodeRef",
    "destinationAddress",
    "cadence",
    "paused"
  ],
  "statusFields": [
    "observedGeneration",
    "phase",
    "conditions",
    "admittedNetwork",
    "admittedTarget",
    "activeCadenceGeneration",
    "acknowledgedBlocks",
    "ambiguousAttempts",
    "lastSelectedInterval",
    "lastAcknowledgedAt",
    "lastAmbiguousAt",
    "recentBlockHashes"
  ],
  "statusSubresource": true,
  "targetIdentityContract": "bind-object-uids-refresh-admitted-runtime-identity",
  "timer": {
    "implementation": "requeue-after-with-process-memory",
    "keyFields": [
      "namespace",
      "name",
      "objectUID",
      "activeCadenceGeneration"
    ],
    "restartBehavior": "select-fresh-full-delay",
    "staleReconcileBehavior": "evaluate-current-key-and-due-time"
  },
  "yield": {
    "actionPhases": [
      "Admitted",
      "Active",
      "Recovering"
    ],
    "leaseNotification": "managed-label-filtered-watch-target-uid-index",
    "lookup": "uncached-list-before-every-acquisition",
    "minimumGapAfterRelease": "configured-selected-interval",
    "pendingReason": "TargetBusy",
    "pendingRequirement": "admission-complete-waiting-only-for-reservation",
    "scope": "same-namespace-and-bitcoin-node-reference"
  }
}
