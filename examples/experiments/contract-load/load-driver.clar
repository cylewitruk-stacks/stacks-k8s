(define-private (write-step2 (op (tuple (key uint) (payload (buff 4096)))) (acc uint))
 (+ acc (unwrap-panic (contract-call? .load-relay write2 (get key op) (get payload op)))))
(define-private (read-step2 (key uint) (acc uint))
 (+ acc (unwrap-panic (contract-call? .load-relay read2 key))))
(define-public (run2 (writes (list 64 (tuple (key uint) (payload (buff 4096))))) (reads (list 512 uint)))
 (ok (+ (fold write-step2 writes u0) (fold read-step2 reads u0))))

