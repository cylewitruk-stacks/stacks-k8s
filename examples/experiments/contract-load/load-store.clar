 (ok (match (map-get? rows8 key) row (+ (len (get f0 row)) (len (get f1 row)) (len (get f2 row)) (len (get f3 row)) (len (get f4 row)) (len (get f5 row)) (len (get f6 row)) (len (get f7 row))) u0)))

